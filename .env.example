# Copy to .env for local development:
#   cp .env.example .env

SECRET_KEY=dev-change-me-in-production

# Optional: override SQLite path
# DATABASE_URL=sqlite:///absolute/path/to/neetcode.db

# Gemini AI coach (required for problem-page chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Daily email challenge — leave MAIL_SERVER empty to log emails to the console
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=neetcode250@example.com
# Default send time for new users (each user can override in Settings)
# EMAIL_CHALLENGE_HOUR=9
# EMAIL_CHALLENGE_MINUTE=0
# APP_BASE_URL=http://127.0.0.1:5001
